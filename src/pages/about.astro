---

import { getCollection, getEntry, render } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import { getPostUrlBySlug } from "@utils/url-utils";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const aboutPost = await getEntry("spec", "about");

if (!aboutPost) {
	throw new Error("About page content not found");
}

const { Content } = await render(aboutPost);
const affiliations = (await getCollection("posts"))
	.filter((post) => post.data.category?.toLowerCase() === "career")
	.sort((a, b) => a.data.published.getTime() - b.data.published.getTime());
const formatDate = (date: Date) => new Intl.DateTimeFormat("ko-KR", { year: "numeric", month: "2-digit" })
	.format(date).replace(/\. /g, ".").replace(/\.$/, "");
---
<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <div class="about-intro" data-scroll-reveal>
                <Markdown class="mt-2">
                    <Content />
                </Markdown>
            </div>
            {affiliations.length > 0 && (
                <section class="affiliation-section">
                    <h2 data-scroll-reveal>Affiliation</h2>
                    <div class="timeline">
                        {affiliations.map((post, index) => (
                            <a class="timeline-item" href={getPostUrlBySlug(post.slug)} data-scroll-reveal style={`--reveal-delay: ${index * 90}ms`}>
                                <span class="dot"></span>
                                <div>
                                    <h3>{post.data.title}</h3>
                                    <div class="meta">
                                        {post.data.role && <span class="badge">{post.data.role}</span>}
                                        <time>{formatDate(post.data.published)} ~ Present</time>
                                    </div>
                                </div>
                            </a>
                        ))}
                    </div>
                </section>
            )}
        </div>
    </div>
</MainGridLayout>

<script>
    const setupScrollReveal = () => {
        document.documentElement.classList.add("scroll-reveal-ready");
        const items = document.querySelectorAll<HTMLElement>("[data-scroll-reveal]");
        const observer = new IntersectionObserver((entries, currentObserver) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                entry.target.classList.add("is-visible");
                currentObserver.unobserve(entry.target);
            });
        }, { threshold: 0.16, rootMargin: "0px 0px -5%" });
        items.forEach((item) => observer.observe(item));
    };

    if (window.swup) {
        setupScrollReveal();
        window.swup.hooks.on("page:view", setupScrollReveal);
    } else {
        document.addEventListener("swup:enable", () => {
            setupScrollReveal();
            window.swup.hooks.on("page:view", setupScrollReveal);
        }, { once: true });
    }
</script>

<style>
    html.scroll-reveal-ready [data-scroll-reveal] { opacity: 0; transform: translateY(1.3rem); transition: opacity .6s ease, transform .6s cubic-bezier(.2, .75, .2, 1); transition-delay: var(--reveal-delay, 0ms); }
    html.scroll-reveal-ready [data-scroll-reveal].is-visible { opacity: 1; transform: translateY(0); }
    .affiliation-section { margin: 3.5rem .5rem .75rem; }
    .affiliation-section h2, .affiliation-section h3 { color: var(--text-90); letter-spacing: -.055em; }
    .affiliation-section h2 { margin: 0 0 2.25rem; font-size: clamp(1.8rem, 3.3vw, 2.3rem); }
    .timeline { position: relative; display: grid; gap: 2.35rem; padding-left: 2.85rem; }
    .timeline::before { content: ""; position: absolute; top: .65rem; bottom: .65rem; left: .48rem; width: 2px; background: color-mix(in srgb, var(--primary) 24%, transparent); }
    .timeline-item { position: relative; display: block; color: inherit; text-decoration: none; }
    .dot { position: absolute; top: .38rem; left: -2.85rem; width: .98rem; height: .98rem; border: 4px solid var(--card-bg); border-radius: 50%; background: var(--primary); box-shadow: 0 0 0 1px color-mix(in srgb, var(--primary) 20%, transparent); }
    .timeline-item h3 { margin: 0; font-size: 1.15rem; }
    .meta { display: flex; flex-wrap: wrap; align-items: center; gap: .65rem; margin-top: .75rem; color: var(--text-50); font-size: .86rem; }
    .badge { padding: .29rem .72rem; border: 1px solid color-mix(in srgb, var(--primary) 28%, transparent); border-radius: 999px; color: var(--primary); background: color-mix(in srgb, var(--primary) 7%, transparent); font-weight: 700; }
    @media (prefers-reduced-motion: reduce) { html.scroll-reveal-ready [data-scroll-reveal] { opacity: 1; transform: none; transition: none; } }
    @media (max-width: 640px) { .affiliation-section { margin-left: 0; margin-right: 0; }.timeline { padding-left: 2.3rem; }.dot { left: -2.3rem; } }
</style>
